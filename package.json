{
  "name": "my-prophecy",
  "version": "0.1.0",
  "private": true,
  "description": "Native-feeling web editor for the Sequential Prophet Rev2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.css\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm test && npm run build && npm audit",
    "postinstall": "node scripts/copy-basic-pitch-model.mjs",
    "trackpad:build": "companion/trackpad-midi/build.sh",
    "trackpad": "npm run trackpad:build && bin/trackpad-midi",
    "trackpad:daemon": "npm run trackpad:build && bin/trackpad-midi --daemon --out MidiLink"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@spotify/basic-pitch": "^1.0.1"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT"
}
